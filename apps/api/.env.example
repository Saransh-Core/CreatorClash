NODE_ENV=development
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set both values together when connecting a Supabase project.
# The anon key is not a secret; the API still verifies each caller's access token.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only; required for Twitch credential linking. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -base64 32
TWITCH_TOKEN_ENCRYPTION_KEY=
# Twitch OAuth authorization-code flow; never expose the secret to the browser.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/callback
# Optional; suggestions generation returns an explicit 503 until configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
