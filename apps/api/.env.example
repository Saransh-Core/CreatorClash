NODE_ENV=development
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set both values together when connecting a Supabase project.
# The anon key is not a secret; the API still verifies each caller's access token.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional; suggestions generation returns an explicit 503 until configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
